 .ob-card {
-  position: fixed; z-index: 82; pointer-events: auto; left: 50%; width: min(440px, calc(100vw - 24px));
-  transform: translateX(-50%); padding: 16px 16px 14px; border-radius: 22px; color: #1b1340;
